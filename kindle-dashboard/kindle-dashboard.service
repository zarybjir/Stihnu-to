# Automatické spuštění po startu (Raspberry Pi / Linux).
# Uprav cesty a uživatele, pak:
#   sudo cp kindle-dashboard.service /etc/systemd/system/
#   sudo systemctl enable --now kindle-dashboard
[Unit]
Description=Kindle dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/kindle-dashboard
ExecStart=/home/pi/kindle-dashboard/.venv/bin/python dashboard.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
